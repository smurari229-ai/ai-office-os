# Optional server-side Gemini API integration. Never prefix this key with VITE_.
# Add the real key as a Vercel Environment Variable named GEMINI_API_KEY.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# DukaanAI Supabase browser client (safe public values only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
